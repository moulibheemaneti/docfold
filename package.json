{
  "name": "@moulibheemaneti/docfold",
  "version": "0.1.1",
  "description": "Turn a folder of markdown into a searchable docs site. Folders become the sidebar, front matter becomes filters. Runs on Bun.",
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "static-site-generator",
    "front-matter",
    "adr",
    "knowledge-base",
    "bun"
  ],
  "license": "MIT",
  "homepage": "https://github.com/moulibheemaneti/docfold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moulibheemaneti/docfold.git"
  },
  "bugs": {
    "url": "https://github.com/moulibheemaneti/docfold/issues"
  },
  "type": "module",
  "bin": {
    "docfold": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7"
  }
}
